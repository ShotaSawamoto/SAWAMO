<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use the canonical HTTPS URL without www.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^kumanotrailstays\.com$ [NC]
  RewriteRule ^ https://kumanotrailstays.com%{REQUEST_URI} [R=301,L]

  # Serve the Vite application for routes such as /contact.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
